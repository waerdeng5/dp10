{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "user-select",
          "backdrop-filter",
          "-webkit-text-size-adjust",
          "-ms-filter",
          "mask-image",
          "overscroll-behavior",
          "overscroll-behavior: none",
          "-webkit-box-reflect",
          "scrollbar-color",
          "scrollbar-width",
          "overflow: clip",
          "rx",
          "ry",
          "text-wrap",
          "text-wrap: balance",
          "-webkit-user-drag",
          "background-color: color-mix(in srgb, currentColor 25%, transparent)",
          "-webkit-mask-composite",
          "mask-composite"
        ]
      }
    ]
  }
}
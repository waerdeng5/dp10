{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "user-select",
          "backdrop-filter",
          "-webkit-text-size-adjust",
          "-ms-filter",
          "mask-image",
          "overscroll-behavior",
          "overscroll-behavior: none",
          "-webkit-box-reflect",
          "scrollbar-color",
          "scrollbar-width"
        ]
      }
    ]
  }
}
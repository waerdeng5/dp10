{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "user-select",
          "backdrop-filter",
          "-webkit-text-size-adjust",
          "-ms-filter",
          "mask-image",
          "overscroll-behavior",
          "overscroll-behavior: none",
          "-webkit-box-reflect",
          "scrollbar-color",
          "scrollbar-width",
          "overflow: clip",
          "rx",
          "ry",
          "text-wrap",
          "text-wrap: balance",
          "-webkit-user-drag",
          "background-color: color-mix(in srgb, currentColor 25%, transparent)",
          "-webkit-mask-composite",
          "mask-composite",
          "mask-composite: intersect",
          "outline: 2px solid color-mix(in srgb, var(--sb-text-color) 55%, transparent)",
          "color: color-mix(in srgb, var(--ow-active-color) calc(var(--ow-p, 0) * 100%), var(--ow-text-color))"
        ]
      }
    ],
    "css-prefix-order": "off"
  }
}